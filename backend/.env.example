# Copy this file to .env and fill in the real values. The .env file is ignored
# by Git; this one is not. Never put a real password or key in this file.

# --- Phase 1 -----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/insta_clone

# --- Phase 3 -----------------------------------------------------------------
# Signs the login tokens. Anyone holding this key can mint a valid token for
# ANY user, so treat it as seriously as the database password above.
#
# Do NOT invent one by typing. Generate a real random one:
#
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# Changing this value instantly invalidates every token already issued, which
# logs everybody out. That is occasionally useful on purpose.
JWT_SECRET_KEY=run_the_command_above_and_paste_the_result_here

# How long a login token stays valid, in minutes. After this it is refused and
# the user must log in again. Shorter is safer; longer is more convenient.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- Phase 4 -----------------------------------------------------------------
# Where the website runs. Your browser refuses to let a page loaded from one
# address call a different address, so the backend must explicitly name the
# origin it trusts. 5173 is Vite's default port.
#
# SEVERAL addresses may be listed, separated by commas, so one deployment can
# allow the live site and a developer's laptop at the same time:
#
#     FRONTEND_ORIGIN=http://localhost:5173,https://insta-clone.onrender.com
#
# Write each one exactly as the browser sees it: the right protocol (https in
# production) and NO trailing slash. A stray slash makes the check fail, and
# it fails silently from the server's side.
FRONTEND_ORIGIN=http://localhost:5173

# --- Deployment notes ---------------------------------------------------------
# On a hosting platform there is no .env file. Set these same names as the
# platform's own environment variables and everything works unchanged --
# load_dotenv does nothing when the file is absent, and os.getenv then reads
# the real environment.
#
# Two things MUST differ in production:
#
#   JWT_SECRET_KEY   generate a NEW one. Never reuse the development key: if
#                    it ever leaks, whoever has it can mint a valid login
#                    token for any user on the live site.
#
#   DATABASE_URL     hosting providers usually hand you a string beginning
#                    "postgresql://" or "postgres://". This project needs the
#                    driver named explicitly, so change the part before "://"
#                    to "postgresql+psycopg". Without it SQLAlchemy looks for
#                    psycopg2, which is not installed, and the app will not
#                    start.

# --- Phase 12 -----------------------------------------------------------------
# Cloudinary, where the photos actually live.
#
# Why an outside service at all: Render wipes the server's own disk on every
# restart and every deploy. A photo saved into a folder on the server would
# disappear with no error and no explanation. So the file goes to Cloudinary
# and only the link it hands back is stored in our database.
#
# Get these three from the Cloudinary dashboard after signing up (free plan).
#
# CLOUDINARY_API_SECRET is a real secret: anyone holding it can upload to, and
# delete from, your account. Treat it like the database password. The cloud
# name and API key are not secret, but keep all three together for simplicity.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
