# Copy to .env only if your backend is NOT on http://localhost:8000.
# client.js falls back to that address, so for normal development you do not
# need a .env file at all.
#
# WARNING: every VITE_ variable is baked into the JavaScript sent to the
# browser, so treat all of them as PUBLIC. Never put a password, a database
# URL or a secret key in this file. Those belong in backend/.env only.
VITE_API_URL=http://localhost:8000
